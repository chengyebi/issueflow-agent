GITHUB_WEBHOOK_SECRET=

# 审核台管理员 Token。建议使用：
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
REVIEW_ADMIN_TOKEN=

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
GITHUB_TOKEN=
GITHUB_WRITE_ENABLED=false

AGENT_MODE=workflow
PROMPT_VERSION=triage-v2
AGENT_VERSION=workflow-v2
# 选择性自动化 rollout mode：off | shadow | enforce
# off=完全旧 review-all；shadow=记录策略裁定但动作仍走人工；enforce=按策略真正自动写回
AUTOMATION_MODE=shadow
# 冻结策略 artifact 路径（相对仓库根），为空时用默认 eval/automation/policy.json
AUTOMATION_POLICY_PATH=
RQ_MAX_RETRIES=2
RQ_RETRY_INTERVALS=10,30

# 仅在已确认供应商单价时填写；留空时不估算成本。
LLM_INPUT_COST_PER_MILLION_USD=
LLM_OUTPUT_COST_PER_MILLION_USD=

# FastEmbed 只在本机 Docker CPU 中运行，不上传 Issue 内容。
# 首次启动允许下载；缓存完成后可设 EMBEDDING_LOCAL_FILES_ONLY=true 离线运行。
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_PREFIX=
EMBEDDING_CACHE_DIR=/var/cache/issueflow/fastembed
EMBEDDING_LOCAL_FILES_ONLY=false
DUPLICATE_TOP_K=5
DUPLICATE_RRF_K=60
DUPLICATE_RERANKER_ENABLED=false
EMBEDDING_CHUNK_SIZE=384
EMBEDDING_CHUNK_OVERLAP=64
EMBEDDING_MAX_CHUNKS=16
EMBEDDING_CHUNK_STRATEGY_VERSION=title-body-token-v1
EMBEDDING_CHUNK_AGGREGATION=max_chunk_score
EVAL_REPOS=microsoft/vscode,nodejs/node,rust-lang/rust
EVAL_CORPUS_LIMIT_PER_REPO=2000
EVAL_QUERY_LIMIT_PER_REPO=50
